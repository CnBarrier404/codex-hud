{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex HUD",
  "version": "0.1.0",
  "identifier": "com.codexhud.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex HUD",
        "width": 320,
        "height": 350,
        "visible": false,
        "transparent": true,
        "theme": "Light",
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
